# Copy to .env for local development, and set the same variables in your host
# (Netlify: Site configuration -> Environment variables). Never commit real values.

# ---- Public (exposed to the browser bundle) ----
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_ID=your-project-ref

# ---- Server-side (SSR / server functions) ----
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_PROJECT_ID=your-project-ref

# ---- SERVER ONLY. Never prefix with VITE_. Never expose to the browser. ----
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
